{
  "name": "plutonio",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\"",
    "validar": "npm run lint && npm run typecheck && npm test",
    "build:aab": "ENVFILE=.env.prod sh -c 'cd android && ./gradlew bundleRelease'",
    "build:apk": "ENVFILE=.env.prod sh -c 'cd android && ./gradlew assembleRelease'",
    "prepare": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.1",
    "@react-native/new-app-screen": "0.88.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@tanstack/react-query": "^5.105.0",
    "axios": "^1.21.0",
    "lucide-react-native": "^1.64.0",
    "react": "19.3.0",
    "react-hook-form": "^7.91.0",
    "react-native": "0.88.0",
    "react-native-config": "^1.7.2",
    "react-native-keychain": "^10.0.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.30.0",
    "react-native-svg": "^15.16.0",
    "react-native-toast-message": "^2.5.2",
    "react-native-unistyles": "^3.6.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-export-namespace-from": "^7.29.7",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/eslint-config": "0.88.0",
    "@react-native/jest-preset": "0.88.0",
    "@react-native/metro-config": "0.88.0",
    "@react-native/typescript-config": "0.88.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest": "^29.6.3",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "react-test-renderer": "19.3.0",
    "test-renderer": "^1.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ]
  }
}
