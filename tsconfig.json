{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "allowJs": false,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "__tests__", "*.ts", "*.tsx", "*.d.ts"],
  "exclude": ["**/node_modules", "**/Pods", "android", "ios"]
}
