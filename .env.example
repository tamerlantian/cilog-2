# Copia este archivo a .env (desarrollo) y .env.prod (release). No se versionan.
# Emulador Android: http://10.0.2.2:8000  |  Producción: https://api.semanticaapi.com.co
API_URL=http://10.0.2.2:8000
ENTORNO=dev
# Cloudflare Turnstile (registro y recuperación de clave). Vacío = sin desafío.
TURNSTILE_SITE_KEY=
# Hostname autorizado en el widget; vacío = el de API_URL.
TURNSTILE_BASE_URL=
